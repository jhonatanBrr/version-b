// Button: .btn + modifiers --primary | --outline | --soft | --ghost, --lg, --block
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 20px;
  border: 1px solid transparent;
  border-radius: $radius;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  transition: color 0.15s, background-color 0.15s, border-color 0.15s, transform 0.15s;

  &:active {
    transform: scale(0.98);
  }

  &:disabled,
  &[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.6;
  }

  &--primary {
    background: var(--ds-primary);
    color: var(--ds-on-primary);

    &:hover {
      background: var(--ds-primary-hover);
    }
  }

  &--outline {
    border-color: var(--ds-primary);
    background: var(--ds-surface);
    color: var(--ds-link);

    &:hover {
      background: var(--ds-soft);
    }
  }

  &--soft {
    background: var(--ds-soft);
    color: var(--ds-link);

    &:hover {
      background: var(--ds-soft-hover);
    }
  }

  &--ghost {
    color: var(--ds-ink);

    &:hover {
      background: var(--ds-soft);
    }
  }

  &--lg {
    min-height: 56px;
    padding: 0 28px;
    font-size: 17px;
  }

  &--block {
    width: 100%;
  }
}

// Icon-only button (always paired with aria-label)
.icon-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: $radius;
  background: transparent;
  color: var(--ds-ink);
  transition: background-color 0.15s;

  &:hover {
    background: var(--ds-soft);
  }

  &__badge {
    position: absolute;
    top: 2px;
    right: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: $radius;
    background: var(--ds-primary);
    color: var(--ds-on-primary);
    font-size: 11px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
}

// Badge: .badge + --neutral | --brand | --solid | --inverse
.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: $radius;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.4;

  &__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot, currentColor);
  }

  &--neutral {
    background: unquote("color-mix(in srgb, var(--ds-surface) 95%, transparent)");
    color: var(--ds-ink);
    box-shadow: 0 1px 2px rgba(15, 45, 82, 0.15);
  }

  &--brand {
    background: var(--ds-soft);
    color: var(--ds-link);
  }

  &--solid {
    background: var(--ds-primary);
    color: var(--ds-on-primary);
  }

  &--inverse {
    background: var(--ds-strong);
    color: #ffffff;
  }
}

// Filter chip: .chip + --soft, state via aria-pressed
.chip {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 0 16px;
  border: 1px solid var(--ds-line);
  border-radius: $radius;
  background: var(--ds-surface);
  color: var(--ds-ink);
  font-size: 14px;
  white-space: nowrap;
  transition: background-color 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s;

  &:hover {
    border-color: var(--ds-line-strong);
    background: var(--ds-soft-2);
  }

  &--counted {
    padding-right: 8px;
  }

  &__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot, currentColor);
  }

  &__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    padding: 0 8px;
    border-radius: $radius;
    background: var(--ds-soft);
    color: var(--ds-link);
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  &[aria-pressed="true"] {
    border-color: var(--ds-primary);
    background: var(--ds-primary);
    color: var(--ds-on-primary);
    font-weight: 600;
    box-shadow: 0 8px 18px -10px rgba(27, 79, 138, 0.7);

    .chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--ds-on-primary);
    }
  }

  &--soft[aria-pressed="true"] {
    border-color: var(--ds-link);
    background: var(--ds-soft);
    color: var(--ds-ink);
    box-shadow: none;
  }
}

// Form field: .field > __label, __control (+ --error), __error
.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;

  &__label {
    font-size: 14px;
    font-weight: 700;
  }

  &__hint {
    margin-left: 4px;
    font-weight: 400;
    color: var(--ds-muted);
  }

  &__control {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--ds-line);
    border-radius: $radius;
    background: var(--ds-surface);
    color: var(--ds-ink);
    font-size: 16px;
    transition: border-color 0.15s, box-shadow 0.15s;

    &::placeholder {
      color: var(--ds-muted);
    }

    &:focus {
      outline: none;
      border-color: var(--ds-link);
      box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.2);
    }

    &--error {
      border-color: var(--ds-danger);
    }

    &--textarea {
      resize: vertical;
    }
  }

  &__error {
    font-size: 13px;
    font-weight: 500;
    color: var(--ds-danger);
  }
}

// Price: .price > __current, __original; size modifiers --sm | --lg
.price {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4px 10px;

  &__current {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  &__original {
    font-size: 14px;
    color: var(--ds-muted);
    font-variant-numeric: tabular-nums;
  }

  &--sm &__current {
    font-size: 16px;
  }

  &--lg &__current {
    font-family: $font-display;
    font-size: 34px;
  }
}
