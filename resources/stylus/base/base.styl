$font-sans = "Noto Sans", "Helvetica Neue", Helvetica, Arial, sans-serif
$font-display = "Inter Tight", "Noto Sans", sans-serif

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  background: var(--ds-bg);
  color: var(--ds-ink);
  -webkit-font-smoothing: antialiased;
  text-size-adjust: 100%;
}

body {
  margin: 0;
  min-height: 100dvh;
  background: var(--ds-bg);
  color: var(--ds-ink);
  font-family: $font-sans;
  font-size: 16px;
  line-height: 1.5;
  transition: background-color 0.3s, color 0.3s;
}

h1, h2, h3, h4 {
  margin: 0;
  font-family: $font-display;
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

p, ul, ol, dl, dd, figure {
  margin: 0;
}

ul, ol {
  padding: 0;
  list-style: none;
}

a {
  color: inherit;
  text-decoration: none;
}

img, svg {
  display: block;
  max-width: 100%;
}

button, input, select, textarea {
  font: inherit;
  color: inherit;
}

button {
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--ds-focus);
  outline-offset: 2px;
}

[hidden] {
  display: none !important;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

// Skip link: visible only when focused.
.skip-link {
  @extend .sr-only;

  &:focus {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 100;
    width: auto;
    height: auto;
    margin: 0;
    padding: 12px 16px;
    clip: auto;
    border-radius: $radius;
    background: var(--ds-primary);
    color: var(--ds-on-primary);
    font-weight: 700;
  }
}

.container {
  width: 100%;
  max-width: $container-max;
  margin: 0 auto;
  padding: 0 16px;

  +above($bp-sm) {
    padding: 0 24px;
  }

  +above($bp-lg) {
    padding: 0 40px;
  }
}

.eyebrow {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ds-link);
}

.tabular {
  font-variant-numeric: tabular-nums;
}
