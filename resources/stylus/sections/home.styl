// Home page sections: hero (+ featured card), catalog and contact.

$section-title()
  font-family: $font-display
  font-size: 30px
  line-height: 1.2
  letter-spacing: -0.025em
  color: var(--ds-ink)

  +above($bp-sm)
    font-size: 36px
    line-height: 1.11

// Hero ----------------------------------------------------------------------
.hero
  border-bottom: 1px solid var(--ds-line)
  background: linear-gradient(to bottom right, var(--ds-soft), var(--ds-soft), var(--ds-surface))

  &__inner
    display: grid
    align-items: center
    gap: 40px
    padding-top: 56px
    padding-bottom: 56px

    +above($bp-sm)
      padding-top: 64px
      padding-bottom: 64px

    +above($bp-lg)
      grid-template-columns: 1.15fr 1fr
      gap: 64px
      padding-top: 96px
      padding-bottom: 96px

  &__copy
    display: flex
    flex-direction: column
    gap: 24px

  &__title
    font-size: 36px
    line-height: 1.08
    letter-spacing: -0.025em
    color: var(--ds-ink)

    +above($bp-sm)
      font-size: 48px

    +above($bp-lg)
      font-size: 56px

  &__subtitle
    max-width: 576px
    font-size: 18px
    line-height: 1.625
    color: var(--ds-muted)

    +above($bp-sm)
      font-size: 21px

  &__actions
    display: flex
    flex-direction: column
    gap: 12px

    +above($bp-sm)
      flex-direction: row

  &__stats
    display: flex
    flex-direction: column
    gap: 8px
    padding-top: 8px
    font-size: 14px
    font-weight: 500
    color: var(--ds-ink)

    +above($bp-sm)
      flex-direction: row
      flex-wrap: wrap
      column-gap: 24px

  &__stat
    display: flex
    align-items: center
    gap: 8px

  &__stat-icon
    color: var(--ds-link)

// Featured product card (hero) ----------------------------------------------
.featured
  position: relative
  display: flex
  flex-direction: column
  overflow: hidden
  border: 1px solid var(--ds-line)
  border-radius: $radius
  background: var(--ds-surface)
  box-shadow: 0 30px 60px -30px unquote("rgb(var(--ds-shadow) / 0.45)")
  transition: transform 0.3s, box-shadow 0.3s

  &:hover
    transform: translateY(-4px)

  &__media
    position: relative
    aspect-ratio: 4 / 3
    overflow: hidden
    background: var(--ds-paper)

  &__image
    width: 100%
    height: 100%
    object-fit: cover
    transition: transform 0.7s

  &:hover &__image
    transform: scale(1.04)

  [data-theme="dark"] &__image
    filter: brightness(0.85) saturate(0.7)

  &__tag
    position: absolute
    top: 16px
    left: 16px
    font-size: 14px

  &__body
    display: flex
    flex-direction: column
    gap: 12px
    padding: 24px

  &__eyebrow
    font-size: 12px
    font-weight: 700
    letter-spacing: 0.05em
    text-transform: uppercase
    color: var(--ds-link)

  &__title
    font-size: 24px
    line-height: 1.375
    letter-spacing: -0.025em

  &__link
    transition: color 0.15s

    &::after
      content: ""
      position: absolute
      inset: 0

    &:hover
      color: var(--ds-link)

  &__summary
    color: var(--ds-muted)

  @media (prefers-reduced-motion: reduce)
    &:hover,
    &:hover .featured__image
      transform: none

// Catalog -------------------------------------------------------------------
.catalog
  scroll-margin-top: 96px
  padding: 64px 0
  background: var(--ds-bg)

  +above($bp-sm)
    padding: 80px 0

  &__inner
    display: flex
    flex-direction: column
    gap: 32px

  &__header
    display: flex
    flex-direction: column
    gap: 8px

  &__title
    $section-title()

  &__browser
    display: flex
    flex-direction: column
    gap: 24px

  &__filters
    display: flex
    flex-direction: column
    gap: 16px

  &__chips
    display: flex
    flex-wrap: wrap
    gap: 8px

    // Categories scroll horizontally on phones, edge to edge.
    &--scroll
      flex-wrap: nowrap
      margin: 0 -16px
      padding: 0 16px 4px
      overflow-x: auto

      +above($bp-sm)
        flex-wrap: wrap
        margin: 0
        padding: 0 0 4px
        overflow-x: visible

  &__results
    font-size: 14px
    font-weight: 500
    color: var(--ds-muted)

  &__grid
    display: grid
    grid-template-columns: 1fr
    gap: 24px

    +above($bp-sm)
      grid-template-columns: repeat(2, 1fr)

    +above($bp-lg)
      grid-template-columns: repeat(3, 1fr)

  &__item,
  &__card
    display: flex

  &__card
    width: 100%

  &__empty
    display: flex
    flex-direction: column
    align-items: center
    gap: 12px
    padding: 56px 24px
    border: 1px dashed var(--ds-line-strong)
    border-radius: $radius
    background: var(--ds-surface)
    text-align: center

  &__empty-title
    font-size: 20px

  &__empty-text
    max-width: 448px
    color: var(--ds-muted)

  &__reset
    margin-top: 8px

// Contact -------------------------------------------------------------------
.contact
  scroll-margin-top: 96px
  padding: 64px 0
  border-top: 1px solid var(--ds-line)
  background: var(--ds-soft)

  +above($bp-sm)
    padding: 80px 0

  &__inner
    display: grid
    gap: 40px

    +above($bp-lg)
      grid-template-columns: 1fr 1.1fr
      gap: 64px

  &__intro
    display: flex
    flex-direction: column
    gap: 16px

  &__title
    $section-title()

  &__text
    max-width: 512px
    font-size: 18px
    line-height: 1.625
    color: var(--ds-muted)

  &__points
    display: flex
    flex-direction: column
    gap: 12px
    padding-top: 8px

  &__point
    display: flex
    align-items: center
    gap: 12px
    font-weight: 500

  &__point-icon
    display: inline-flex
    flex: none
    align-items: center
    justify-content: center
    width: 32px
    height: 32px
    border-radius: 50%
    background: var(--ds-surface)
    color: var(--ds-link)

$contact-panel()
  border: 1px solid var(--ds-line)
  border-radius: $radius
  background: var(--ds-surface)
  padding: 24px

  +above($bp-sm)
    padding: 32px

.contact-form
  $contact-panel()
  display: flex
  flex-direction: column
  gap: 20px

  &__submit
    align-self: flex-start

.contact-success
  $contact-panel()
  display: flex
  flex-direction: column
  align-items: flex-start
  gap: 16px

  &__icon
    display: inline-flex
    align-items: center
    justify-content: center
    width: 48px
    height: 48px
    border-radius: 50%
    background: var(--ds-primary)
    color: var(--ds-on-primary)

  &__title
    font-size: 24px
    letter-spacing: -0.025em

  &__text
    color: var(--ds-muted)
