// Product page (resources/views/pages/product.blade.php + sections/product/*)

// Page layout: stacked below 1024px, two columns with a sticky gallery above.
.product-page {
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding-top: 32px;
  padding-bottom: 32px;

  +above($bp-lg) {
    gap: 48px;
    padding-top: 48px;
    padding-bottom: 48px;
  }

  &__main {
    display: grid;
    gap: 32px;

    +above($bp-lg) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px;
    }
  }

  &__gallery {
    +above($bp-lg) {
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }

  &__info {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
}

// Breadcrumb
.product-breadcrumb {
  font-size: 14px;

  &__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    color: var(--ds-muted);
  }

  &__link {
    border-radius: $radius;

    &:hover {
      color: var(--ds-link);
      text-decoration: underline;
    }
  }

  &__separator {
    color: var(--ds-muted);
  }

  &__current {
    font-weight: 700;
    color: var(--ds-ink);
  }
}

// Gallery: 4:3 photo with the "new" badge
.product-gallery {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: $radius;
  background: var(--ds-soft);

  &__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;

    [data-theme="dark"] & {
      filter: brightness(0.85) saturate(0.7);
    }
  }

  &__badge {
    position: absolute;
    top: 16px;
    left: 16px;
  }
}

// Summary: eyebrow, title, people, spec line, description, highlights
.product-summary {
  display: flex;
  flex-direction: column;
  gap: 16px;

  &__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ds-link);
  }

  &__title {
    font-size: 30px;
    line-height: 1.25;
    letter-spacing: -0.025em;

    +above($bp-sm) {
      font-size: 36px;
    }
  }

  &__people,
  &__specs {
    font-size: 14px;
  }

  &__specs,
  &__muted {
    color: var(--ds-muted);
  }

  &__strong {
    font-weight: 500;
  }

  &__description {
    line-height: 1.625;
  }

  &__highlights {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
  }

  &__highlight {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  &__highlight-icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--ds-link);
  }
}

// Buy box
.buy-box {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 20px;
  border: 1px solid var(--ds-line);
  border-radius: $radius;
  background: var(--ds-surface);

  &__pricing {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 -8px;
    padding: 4px 8px;
  }

  &__note {
    font-size: 14px;
    color: var(--ds-muted);
  }

  &__savings {
    font-size: 14px;
    font-weight: 700;
    color: var(--ds-link);
  }

  &__actions {
    display: grid;
    gap: 12px;

    +above($bp-sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  &__status {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ds-link);
  }

  &__confirmation,
  &__status-icon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
}

// Edition picker: native radios styled as cards
.edition-selector {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;

  &__legend {
    margin-bottom: 8px;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
  }

  &__option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--ds-line);
    border-radius: $radius;
    background: var(--ds-surface);
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;

    &:hover {
      border-color: var(--ds-line-strong);
    }

    &:has(:focus-visible) {
      outline: 2px solid var(--ds-focus);
      outline-offset: 2px;
    }
  }

  &__option--checked,
  &__option:has(:checked) {
    border-color: var(--ds-primary);
    background: var(--ds-soft);

    &:hover {
      border-color: var(--ds-primary);
    }
  }

  &__radio {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin: 4px 0 0;
    accent-color: var(--ds-primary);

    &:focus-visible {
      outline: none;
    }
  }

  &__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  &__label {
    font-weight: 700;
  }

  &__detail {
    font-size: 14px;
    color: var(--ds-muted);
  }

  &__price {
    font-weight: 600;
  }
}

// Quantity stepper (− value +)
.quantity-stepper {
  display: flex;
  flex-direction: column;
  gap: 8px;

  &__label {
    font-size: 14px;
    font-weight: 700;
  }

  &__control {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    border: 1px solid var(--ds-line-strong);
    border-radius: $radius;
    background: var(--ds-surface);
  }

  &__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--ds-link);
    font-size: 20px;
    font-weight: 700;
    transition: background-color 0.15s, color 0.15s;

    &:hover {
      background: var(--ds-soft);
    }

    &:disabled {
      cursor: not-allowed;
      color: var(--ds-muted);
      background: transparent;
    }

    &--decrease {
      border-radius: $radius 0 0 $radius;
    }

    &--increase {
      border-radius: 0 $radius $radius 0;
    }
  }

  &__value {
    min-width: 40px;
    font-weight: 700;
    text-align: center;
  }
}

// Delivery promise
.product-delivery {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 14px;

  &__item {
    display: flex;
    align-items: flex-start;
    gap: 8px;

    &--muted {
      color: var(--ds-muted);
    }
  }

  &__icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--ds-link);
  }
}

// Technical sheet / contents accordions (native <details>)
.product-details {
  border-top: 1px solid var(--ds-line);

  &__section {
    border-bottom: 1px solid var(--ds-line);
  }

  &__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    padding: 12px 0;
    font-weight: 700;
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }
  }

  &__chevron {
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  &__section[open] &__chevron {
    transform: rotate(180deg);
  }

  &__sheet,
  &__list {
    padding-bottom: 16px;
    font-size: 14px;
  }

  &__sheet {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 24px;
  }

  &__term {
    color: var(--ds-muted);
  }

  &__value {
    font-weight: 500;
  }

  &__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 20px;
    list-style: disc;
  }
}

// Related products rail: 1 / 2 / 3 columns
.related-products {
  display: flex;
  flex-direction: column;
  gap: 24px;

  &__title {
    font-size: 24px;
    letter-spacing: -0.025em;
  }

  &__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;

    +above($bp-sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    +above($bp-lg) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
}
